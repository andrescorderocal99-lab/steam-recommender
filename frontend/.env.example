# Base URL del catálogo. Debe contener games.json y la carpeta details/.
# En web se usa la ruta relativa ./data (servida desde public/data).
# En la futura app Capacitor apunta a la web/CDN para recibir precios actualizados
# sin republicar la app, p. ej.: VITE_DATA_URL=https://midominio.com/data
VITE_DATA_URL=./data
